# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
FROM --platform=linux/amd64 python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7

RUN test "$(python3 -c 'import platform; print(platform.python_version())')" = 3.12.11 && \
    groupadd --gid 65532 milk && \
    useradd --uid 65532 --gid 65532 --no-create-home --home-dir /tmp --shell /usr/sbin/nologin milk

WORKDIR /opt/milk-harness
COPY --chmod=0444 LICENSE /usr/share/licenses/milk-harness/LICENSE
COPY --chmod=0444 third_party/truss/THIRD_PARTY_NOTICES.md \
  /usr/share/licenses/milk-harness/JOBS-PYTHON-THIRD-PARTY-NOTICES.md
COPY --chmod=0444 third_party/truss/requirements-linux-amd64-cp312.lock /tmp/jobs.lock
RUN python3 -m pip --isolated install \
      --disable-pip-version-check \
      --no-cache-dir \
      --index-url https://pypi.org/simple \
      --only-binary=:all: \
      --require-hashes \
      --requirement /tmp/jobs.lock && \
    rm -f -- /tmp/jobs.lock
COPY --chmod=0444 milk_harness/__init__.py milk_harness/evidence.py milk_harness/budget.py \
  milk_harness/image_admission.py \
  milk_harness/logs.py milk_harness/log_collection.py milk_harness/metrics_collection.py \
  milk_harness/provider_acceptance.py milk_harness/baseten_winner.py \
  milk_harness/scheduler.py milk_harness/jobs.py ./milk_harness/
COPY --chmod=0444 deploy/baseten/adapter.py deploy/baseten/winner.py ./deploy/baseten/
COPY --chmod=0444 deploy/winner_admission.py ./deploy/
RUN chmod 0555 ./milk_harness ./deploy ./deploy/baseten && \
    PYTHONDONTWRITEBYTECODE=1 python3 -c \
  'from importlib.metadata import version; import deploy.baseten.adapter, deploy.baseten.winner, deploy.winner_admission; import milk_harness.baseten_winner, milk_harness.jobs, milk_harness.provider_acceptance, milk_harness.scheduler; assert version("truss") == "0.18.25"' && \
    test "$(TRUSS_NO_UPDATE_CHECK=true /usr/local/bin/truss --version)" = \
      "truss, version 0.18.25" && \
    test "$(/usr/local/bin/python3 -I -c 'from importlib.metadata import version; from truss.base.truss_config import DockerServer; assert version("truss") == "0.18.25"; value = DockerServer.model_validate({"no_build": True, "server_port": 8000, "predict_endpoint": "/v1/chat/completions", "readiness_endpoint": "/health", "liveness_endpoint": "/health"}); assert value.no_build is True and value.start_command is None; print("truss-direct-image-runtime-v1")')" = \
      "truss-direct-image-runtime-v1" && \
    COLUMNS=240 TRUSS_NO_UPDATE_CHECK=true \
      /usr/local/bin/truss --non-interactive push --help \
      > /tmp/truss-push.help && \
    for option in --publish --disable-truss-download --deployment-name --wait \
      --team --labels --output; do \
      test "$(grep -F -c -- "$option" /tmp/truss-push.help)" = 1; \
    done && \
    rm -f -- /tmp/truss-push.help

ENV HOME=/tmp \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/opt/milk-harness
LABEL org.opencontainers.image.title="Milk jobs executor" \
      org.opencontainers.image.source="https://github.com/milkinfrastructure/milk-harness" \
      org.opencontainers.image.licenses="MIT"
USER 65532:65532
ENTRYPOINT ["python3", "-m", "milk_harness.jobs"]
