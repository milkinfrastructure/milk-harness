ADD --checksum=sha256:128338718fadfaaf9f926fe349347edce7645c8ffd1ae2878ca3d807b23fa5c3 https://dl-cdn.alpinelinux.org/alpine/v3.22/main/x86_64/libexpat-2.8.3-r0.apk /packages/libexpat-2.8.3-r0.apk
