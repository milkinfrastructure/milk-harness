# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

FROM golang:1.24.3-alpine3.22@sha256:b4f875e650466fa0fe62c6fd3f02517a392123eea85f1d7e69d85f780e4db1c1 AS supervisor
WORKDIR /src
COPY go.mod ./
COPY cmd/milk-harness ./cmd/milk-harness
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags='-s -w' -o /out/milk-harness ./cmd/milk-harness

FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce AS codex
ARG CODEX_VERSION=0.150.1
ARG CODEX_ARCHIVE_SHA256=ab308870bc7fc048c23dc49d03f6b8af9ce7fc99b9da882d6688be7a90155c7a
ARG CODEX_BINARY_SHA256=abf1bb1643a79f73aa78ee627e111e02d4f8c98f25813a0cf6ce277709664386
RUN wget -q -O /tmp/codex.tar.gz \
      "https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/codex-x86_64-unknown-linux-musl.tar.gz" \
 && echo "${CODEX_ARCHIVE_SHA256}  /tmp/codex.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/codex.tar.gz -C /tmp \
 && echo "${CODEX_BINARY_SHA256}  /tmp/codex-x86_64-unknown-linux-musl" | sha256sum -c - \
 && cp /tmp/codex-x86_64-unknown-linux-musl /usr/local/bin/codex \
 && chmod 0755 /usr/local/bin/codex

FROM scratch AS runtime-packages
ADD --checksum=sha256:a693524543421b3a90f163ccb48d5ad0f5fd773b5c3b640acc461eace2cb01b6 https://dl-cdn.alpinelinux.org/alpine/v3.22/main/x86_64/brotli-libs-1.1.0-r2.apk /packages/brotli-libs-1.1.0-r2.apk
