ADD --checksum=sha256:d6ee515d30d703e94b55ef9c0a02aea053313f654acbd2c655d18e3907ecb66a https://dl-cdn.alpinelinux.org/alpine/v3.22/main/x86_64/nghttp2-libs-1.69.0-r0.apk /packages/nghttp2-libs-1.69.0-r0.apk
ADD --checksum=sha256:cfb8ad103a101fa6a31769e50e188dab9c60124705682d01b3de268795db58ad https://dl-cdn.alpinelinux.org/alpine/v3.22/main/x86_64/pcre2-10.46-r0.apk /packages/pcre2-10.46-r0.apk
ADD --checksum=sha256:1bdd6e57cfbfbfd6e8481cad37ddd5d199950715bec1879b3afb600272dbb09e https://dl-cdn.alpinelinux.org/alpine/v3.22/main/x86_64/zstd-libs-1.5.7-r0.apk /packages/zstd-libs-1.5.7-r0.apk

FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce
LABEL org.opencontainers.image.title="milk-harness planner" \
      org.opencontainers.image.licenses="MIT AND Apache-2.0" \
      org.opencontainers.image.version="0.150.1"
RUN --mount=type=bind,from=runtime-packages,source=/packages,target=/packages,readonly \
    apk add --no-cache --no-network /packages/*.apk \
 && addgroup -S -g 65532 planner \
 && adduser -S -D -H -u 65532 -G planner planner \
 && mkdir -p /home/planner /runs /worktree \
 && chown planner:planner /home/planner /runs /worktree \
 && chmod 0700 /home/planner /runs /worktree
COPY --from=supervisor /out/milk-harness /usr/local/bin/milk-harness
COPY --from=codex /usr/local/bin/codex /usr/local/bin/codex
COPY prompts/iterate.txt /opt/milk/iterate.txt
COPY decision.schema.json /opt/milk/decision.schema.json
COPY third_party/openai-codex/LICENSE /usr/share/licenses/openai-codex/LICENSE
COPY third_party/openai-codex/NOTICE /usr/share/licenses/openai-codex/NOTICE
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/milk-harness"]
