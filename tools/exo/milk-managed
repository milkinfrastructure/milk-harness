#!/bin/sh
set -eu
umask 077

repository=${MILK_MANAGED_REPOSITORY:-github.com/milkinfrastructure/milk-harness}
workflow=${MILK_MANAGED_WORKFLOW:-production-loop.yml}
workflow_ref=${MILK_MANAGED_WORKFLOW_REF:-main}
eval_dir=${MILK_MANAGED_EVAL_DIR:-/etc/milk/evals}
state_root=${MILK_MANAGED_STATE_ROOT:-/var/lib/milk/evals}
eval_owner_uid=${MILK_MANAGED_EVAL_OWNER_UID:-0}
lock_acquired=false
consumed_file=
generation_done=false

valid_component() {
  case "$1" in
    ''|.|..|-*|*[!A-Za-z0-9._-]*) return 1 ;;
  esac
}

valid_dispatch_target() {
  case "$repository" in
    github.com/*/*) ;;
    *) return 1 ;;
  esac
  repository_path=${repository#github.com/}
  repository_owner=${repository_path%%/*}
  repository_name=${repository_path#*/}
  [ "$repository_name" != "$repository_path" ] || return 1
  case "$repository_name" in */*) return 1 ;; esac
  valid_component "$repository_owner" && valid_component "$repository_name" || return 1
  case "$workflow" in
    *.yml|*.yaml) valid_component "$workflow" || return 1 ;;
    *) return 1 ;;
  esac
  case "$workflow_ref" in
    ''|-*|/*|*/|*//*|*..*|*[!A-Za-z0-9._/-]*) return 1 ;;
  esac
}

valid_dispatch_target || exit 64

result() {
  printf '{"ok":%s,"eval_id":"%s","state":"%s","dispatch_state":"%s","generation_done":%s,"changed":%s,"approval_required":%s}\n' \
    "$1" "$eval_id" "$2" "$3" "$generation_done" "$4" "$5"
}

require_gh() {
  command -v gh >/dev/null 2>&1 || {
    result false blocked unknown false false
    exit 0
  }
}

mode_of() {
  stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null
}

owner_of() {
  stat -c '%u' "$1" 2>/dev/null || stat -f '%u' "$1" 2>/dev/null
}

size_of() {
  stat -c '%s' "$1" 2>/dev/null || stat -f '%z' "$1" 2>/dev/null
}

valid_hex() {
  [ "${#1}" -eq "$2" ] || return 1
  case "$1" in
    *[!0-9a-f]*) return 1 ;;
  esac
}

canonical_private_dir() {
  directory=$1
  expected_owner=$2
  expected_mode=$3
  case "$directory" in
    /*) ;;
    *) return 1 ;;
  esac
  [ -d "$directory" ] && [ ! -L "$directory" ] || return 1
  [ "$(owner_of "$directory" || true)" = "$expected_owner" ] || return 1
  [ "$(mode_of "$directory" || true)" = "$expected_mode" ] || return 1
  canonical_directory=$(CDPATH='' cd -- "$directory" 2>/dev/null && pwd -P) || return 1
  [ "$canonical_directory" = "$directory" ]
}

validate_eval_document() {
  canonical_private_dir "$eval_dir" "$eval_owner_uid" 750 || return 1
  eval_document=$eval_dir/$eval_id.json
  [ -f "$eval_document" ] && [ ! -L "$eval_document" ] || return 1
  [ "$(owner_of "$eval_document" || true)" = "$eval_owner_uid" ] || return 1
  [ "$(mode_of "$eval_document" || true)" = 440 ] || return 1
  eval_size=$(size_of "$eval_document" || true)
  case "$eval_size" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "$eval_size" -gt 0 ] && [ "$eval_size" -le 262144 ] || return 1
  eval_confirmation_sha256=$(python3 -c '
import hashlib
import json
import sys

raw = open(sys.argv[1], "rb").read()
value = json.loads(raw)
manifest = value.get("manifest") if isinstance(value, dict) else None
gateway = value.get("gateway_config") if isinstance(value, dict) else None
if (
    not isinstance(manifest, dict)
    or not isinstance(gateway, dict)
    or manifest.get("campaign_id") != sys.argv[2]
    or gateway.get("eval_id") != sys.argv[2]
):
    raise SystemExit(1)
print(hashlib.sha256(raw).hexdigest())
' "$eval_document" "$eval_id" 2>/dev/null) || return 1
  valid_hex "$eval_confirmation_sha256" 64
}

prepare_eval_state() {
  canonical_private_dir "$state_root" "$(id -u)" 700 || return 1
  eval_state_dir=$state_root/$eval_id
  if [ ! -e "$eval_state_dir" ] && [ ! -L "$eval_state_dir" ]; then
    mkdir -m 0700 "$eval_state_dir" 2>/dev/null || :
  fi
  canonical_private_dir "$eval_state_dir" "$(id -u)" 700 || return 1
  state_file=$eval_state_dir/managed-dispatch.state
  approval_file=$eval_state_dir/run-confirmed.approval
  lock_dir=$state_file.lock
}

# shellcheck disable=SC2317
cleanup() {
  if [ -n "$consumed_file" ]; then
    rm -f -- "$consumed_file" >/dev/null 2>&1 || :
  fi
  if [ "$lock_acquired" = true ]; then
    rmdir "$lock_dir" >/dev/null 2>&1 || :
  fi
}

valid_managed_request_id() {
  expected_prefix=$eval_id-
  case "$1" in
    "$expected_prefix"*) request_nonce=${1#"$expected_prefix"} ;;
    *) return 1 ;;
  esac
  [ "${#1}" -eq 97 ] && valid_hex "$request_nonce" 32
}

state_action=
state_request_id=
state_database_id=
state_eval_id=
state_confirmation_sha256=
load_state() {
  if [ ! -e "$state_file" ] && [ ! -L "$state_file" ]; then
    return 1
  fi
  [ -f "$state_file" ] && [ ! -L "$state_file" ] || return 2
  [ "$(owner_of "$state_file" || true)" = "$(id -u)" ] || return 2
  [ "$(mode_of "$state_file" || true)" = 600 ] || return 2
  state_size=$(size_of "$state_file" || true)
  case "$state_size" in
    ''|*[!0-9]*) return 2 ;;
  esac
  [ "$state_size" -le 320 ] || return 2
  [ "$(wc -l <"$state_file" 2>/dev/null | tr -d '[:space:]')" = 6 ] || return 2
  state_version=$(sed -n '1p' "$state_file")
  state_action=$(sed -n '2p' "$state_file")
  state_request_id=$(sed -n '3p' "$state_file")
  state_database_id=$(sed -n '4p' "$state_file")
  state_eval_id=$(sed -n '5p' "$state_file")
  state_confirmation_sha256=$(sed -n '6p' "$state_file")
  [ "$state_version" = milk-managed-state-v3 ] || return 2
  case "$state_action" in
    reconcile|run_confirmed) ;;
    *) return 2 ;;
  esac
  valid_managed_request_id "$state_request_id" || return 2
  case "$state_database_id" in
    pending) ;;
    ''|0|*[!0-9]*) return 2 ;;
  esac
  [ "$state_eval_id" = "$eval_id" ] || return 2
  valid_hex "$state_confirmation_sha256" 64 || return 2
  [ "$state_confirmation_sha256" = "$eval_confirmation_sha256" ] || return 2
}

write_state() {
  write_action=$1
  write_request_id=$2
  write_database_id=$3
  state_tmp=$state_file.tmp.$$
  if [ -e "$state_tmp" ] || [ -L "$state_tmp" ]; then
    return 1
  fi
  if ! printf 'milk-managed-state-v3\n%s\n%s\n%s\n%s\n%s\n' \
    "$write_action" "$write_request_id" "$write_database_id" "$eval_id" \
    "$eval_confirmation_sha256" \
    >"$state_tmp"; then
    rm -f -- "$state_tmp" >/dev/null 2>&1 || :
    return 1
  fi
  chmod 0600 "$state_tmp" || {
    rm -f -- "$state_tmp" >/dev/null 2>&1 || :
    return 1
  }
  if ! mv -- "$state_tmp" "$state_file"; then
    rm -f -- "$state_tmp" >/dev/null 2>&1 || :
    return 1
  fi
}

correlated_database_id=
correlate_once() {
  correlated_database_id=$(gh run list \
    --repo "$repository" \
    --workflow "$workflow" \
    --all \
    --branch "$workflow_ref" \
    --event workflow_dispatch \
    --limit 100 \
    --json databaseId,displayTitle \
    --jq ".[] | select(.displayTitle == \"Milk production loop [managed:$state_request_id]\") | .databaseId" \
    2>/dev/null) || return 2
  case "$correlated_database_id" in
    '') return 1 ;;
    0|*[!0-9]*) return 2 ;;
  esac
}

refresh_state() {
  generation_done=false
  if [ "$state_database_id" = pending ]; then
    if correlate_once; then
      state_database_id=$correlated_database_id
      write_state "$state_action" "$state_request_id" "$state_database_id" || return 2
    else
      correlate_result=$?
      [ "$correlate_result" -eq 1 ] && return 1
      return 2
    fi
  fi
  run_view=$(gh run view "$state_database_id" \
    --repo "$repository" \
    --json status,conclusion,jobs \
    --jq '(.status + ":" + (.conclusion // "")), (.jobs[].name | select(startswith("Provider reconciliation and dispatch [generation_done=")))' \
    2>/dev/null) || return 2
  observation=$(printf '%s\n' "$run_view" | sed -n '1p')
  case "$observation" in
    queued:|in_progress:|requested:|waiting:|pending:|completed:success|completed:action_required|completed:cancelled|completed:failure|completed:neutral|completed:skipped|completed:stale|completed:startup_failure|completed:timed_out) ;;
    *) return 2 ;;
  esac
  if [ "$observation" = completed:success ]; then
    generation_job_name=$(printf '%s\n' "$run_view" | sed -n '2,$p')
    case "$generation_job_name" in
      'Provider reconciliation and dispatch [generation_done=false]') ;;
      'Provider reconciliation and dispatch [generation_done=true]') generation_done=true ;;
      *) return 2 ;;
    esac
  fi
}

read_managed_state() {
  if load_state; then
    return 0
  else
    state_result=$?
  fi
  [ "$state_result" -eq 1 ] && return 1
  return 2
}

report_status() {
  if read_managed_state; then
    :
  else
    state_result=$?
    if [ "$state_result" -eq 1 ]; then
      result true idle idle false false
    else
      result false blocked unknown false false
    fi
    exit 0
  fi
  require_gh
  if refresh_state; then
    :
  else
    refresh_result=$?
    if [ "$refresh_result" -eq 1 ]; then
      result false blocked pending false false
    else
      result false blocked unknown false false
    fi
    exit 0
  fi
  case "$observation" in
    queued:|in_progress:|requested:|waiting:|pending:)
      result true running running false false
      ;;
    completed:success)
      result true ready succeeded false false
      ;;
    completed:action_required)
      result true blocked action_required false true
      ;;
    completed:cancelled|completed:failure|completed:neutral|completed:skipped|completed:stale|completed:startup_failure|completed:timed_out)
      result false failed failed false false
      ;;
  esac
  exit 0
}

prior_dispatch_state=idle
guard_previous_dispatch() {
  if read_managed_state; then
    :
  else
    state_result=$?
    if [ "$state_result" -eq 1 ]; then
      return 0
    fi
    result false blocked unknown false false
    exit 0
  fi
  if refresh_state; then
    :
  else
    refresh_result=$?
    if [ "$refresh_result" -eq 1 ]; then
      result false blocked pending false false
    else
      result false blocked unknown false false
    fi
    exit 0
  fi
  case "$observation" in
    queued:|in_progress:|requested:|waiting:|pending:)
      result true running running false false
      exit 0
      ;;
    completed:action_required)
      result true blocked action_required false true
      exit 0
      ;;
    completed:success)
      prior_dispatch_state=succeeded
      ;;
    completed:cancelled|completed:failure|completed:neutral|completed:skipped|completed:stale|completed:startup_failure|completed:timed_out)
      prior_dispatch_state=failed
      ;;
  esac
}

dispatch() {
  gh workflow run "$workflow" \
    --repo "$repository" \
    --ref "$workflow_ref" \
    --raw-field "authorize_provider_creates=$1" \
    --raw-field "confirmed_run_config_sha256=$eval_confirmation_sha256" \
    --raw-field "managed_eval_id=$eval_id" \
    --raw-field "managed_request_id=$state_request_id" \
    >/dev/null 2>&1
}

start_dispatch() {
  dispatch_authorized=$1
  dispatch_action=$2
  approval_consumed=$3
  request_nonce=$(od -An -N16 -tx1 /dev/urandom 2>/dev/null | tr -d '[:space:]') || request_nonce=
  if ! valid_hex "$request_nonce" 32; then
    result false blocked unknown "$approval_consumed" "$approval_consumed"
    exit 0
  fi
  state_request_id=$eval_id-$request_nonce
  state_action=$dispatch_action
  state_database_id=pending
  if ! write_state "$state_action" "$state_request_id" pending; then
    result false blocked unknown "$approval_consumed" "$approval_consumed"
    exit 0
  fi

  dispatch "$dispatch_authorized" || :
  attempts=10
  while [ "$attempts" -gt 0 ]; do
    if correlate_once; then
      state_database_id=$correlated_database_id
      if write_state "$state_action" "$state_request_id" "$state_database_id"; then
        result true running running true false
      else
        result false blocked unknown true false
      fi
      exit 0
    else
      correlate_result=$?
    fi
    if [ "$correlate_result" -eq 2 ]; then
      result false blocked unknown true false
      exit 0
    fi
    attempts=$((attempts - 1))
    [ "$attempts" -eq 0 ] || sleep 1
  done
  result false blocked pending true false
  exit 0
}

[ "$#" -eq 2 ] || exit 64
action=$1
eval_id=$2
case "$action" in
  status|reconcile|run_confirmed) ;;
  *) exit 64 ;;
esac
valid_hex "$eval_id" 64 || exit 64

if ! validate_eval_document || ! prepare_eval_state; then
  result false blocked unknown false false
  exit 0
fi
if ! mkdir -m 0700 "$lock_dir" 2>/dev/null; then
  result false blocked unknown false false
  exit 0
fi
lock_acquired=true
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if [ "$action" = status ]; then
  report_status
fi

require_gh
guard_previous_dispatch

if [ "$action" = reconcile ]; then
  start_dispatch false reconcile false
fi

if [ ! -e "$approval_file" ] && [ ! -L "$approval_file" ]; then
  result true waiting_for_confirmation "$prior_dispatch_state" false true
  exit 0
fi

approval_candidate=$approval_file.consumed.$$
if [ -e "$approval_candidate" ] || [ -L "$approval_candidate" ]; then
  result false blocked "$prior_dispatch_state" false true
  exit 0
fi
consumed_file=$approval_candidate
if ! mv -- "$approval_file" "$approval_candidate" 2>/dev/null; then
  result true waiting_for_confirmation "$prior_dispatch_state" false true
  exit 0
fi

valid=true
[ -f "$consumed_file" ] && [ ! -L "$consumed_file" ] || valid=false
[ "$(owner_of "$consumed_file" || true)" = "$(id -u)" ] || valid=false
[ "$(mode_of "$consumed_file" || true)" = 600 ] || valid=false
approval_size=$(size_of "$consumed_file" || true)
[ "$approval_size" = 65 ] || valid=false
approved_confirmation_sha256=
if [ "$valid" = true ]; then
  IFS= read -r approved_confirmation_sha256 <"$consumed_file" || valid=false
fi
valid_hex "$approved_confirmation_sha256" 64 || valid=false
[ "$approved_confirmation_sha256" = "$eval_confirmation_sha256" ] || valid=false
if [ "$valid" != true ]; then
  result false blocked "$prior_dispatch_state" true true
  exit 0
fi

start_dispatch true run_confirmed true
